{
  "name": "moose",
  "version": "0.23.3",
  "private": true,
  "description": "A quiet workspace for your coding agents",
  "license": "UNLICENSED",
  "author": "Moose",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/build-notifications.mjs && vite",
    "runtime:start": "node scripts/runtime.mjs start",
    "runtime:status": "node scripts/runtime.mjs status",
    "runtime:stop": "node scripts/runtime.mjs stop",
    "desktop:shared": "pnpm build && node scripts/runtime.mjs desktop",
    "web": "node scripts/web.mjs",
    "web:build": "pnpm build && pnpm web",
    "build": "node scripts/build-notifications.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:providers": "tsx scripts/probe-providers.ts",
    "db:generate": "drizzle-kit generate",
    "native:rebuild": "electron-builder install-app-deps",
    "package": "pnpm build && electron-builder --mac dir --arm64",
    "dist": "pnpm build && electron-builder --mac dmg --arm64",
    "protocol:generate": "codex app-server generate-ts --experimental --out electron/providers/generated/codex",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "test:live": "tsx scripts/live-providers.ts",
    "icon:build": "swift scripts/icon.swift && iconutil -c icns build/icon.iconset -o build/icon.icns",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "perf:measure": "tsx scripts/measure-performance.ts",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "site:build": "pnpm --filter @moose/site build && node distribution/scripts/sync-site.mjs",
    "merch:build": "pnpm --filter @moose/merch build",
    "test:stability": "tsx scripts/stability.ts",
    "size:measure": "node scripts/measure-size.mjs",
    "perf:web": "tsx scripts/measure-web-performance.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@base-ui/react": "1.8.0",
    "@js-temporal/polyfill": "0.5.1",
    "@pierre/diffs": "1.5.1",
    "@playwright/test": "1.63.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "highlight.js": "11.12.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "node-gyp": "13.0.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "smol-toml": "^1.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-electron": "1.1.2",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  },
  "packageManager": "pnpm@12.6.0",
  "build": {
    "appId": "dev.moose.desktop",
    "productName": "Moose",
    "electronLanguages": [
      "en",
      "en_FEMININE",
      "en_MASCULINE",
      "en_NEUTER",
      "en_GB",
      "en_GB_FEMININE",
      "en_GB_MASCULINE",
      "en_GB_NEUTER",
      "zh_CN",
      "zh_CN_FEMININE",
      "zh_CN_MASCULINE",
      "zh_CN_NEUTER"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "dist-native/**",
      "package.json",
      "!**/*.map",
      "!node_modules/better-sqlite3/{deps,src,build,test,tests,benchmark}/**",
      "!node_modules/better-sqlite3/prebuilds/!(darwin-${arch}).node",
      "!node_modules/node-pty/{deps,src,scripts,test,tests}/**",
      "!node_modules/node-pty/node_modules/node-addon-api/**",
      "!node_modules/node-pty/prebuilds/!(darwin-${arch})/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "Moose",
      "artifactName": "Moose-${version}-${arch}.${ext}"
    },
    "afterSign": "scripts/verify-signature.cjs"
  }
}
